{
  "authors": {
    "000081": {
      "name": "宮沢賢治",
      "born": "1896-08-27",
      "died": "1933-09-21",
      "episodes": [
        "宮沢賢治が生きているあいだに出た本は、詩集『春と修羅』と童話集『注文の多い料理店』の2冊だけでした。",
        "宮沢賢治は花巻の農学校の先生を務め、辞めたあとは「羅須地人協会」を開いて、農民に稲作や芸術を教えました。",
        "〔雨ニモマケズ〕は、宮沢賢治が亡くなったあと、トランクの中にあった手帳から見つかりました。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person81.html",
        "https://ja.wikipedia.org/wiki/%E5%AE%AE%E6%B2%A2%E8%B3%A2%E6%B2%BB",
        "https://ja.wikipedia.org/wiki/%E9%9B%A8%E3%83%8B%E3%83%A2%E3%83%9E%E3%82%B1%E3%82%BA"
      ]
    },
    "000879": {
      "name": "芥川龍之介",
      "born": "1892-03-01",
      "died": "1927-07-24",
      "episodes": [
        "芥川龍之介は、短編『鼻』を夏目漱石に絶賛されたことをきっかけに、文壇に認められました。",
        "芥川賞は、芥川龍之介の友人だった菊池寛が、1935年に芥川の名前をとって創設しました。",
        "芥川龍之介は35歳で自ら命を絶ちました。遺した文章の「ぼんやりした不安」という言葉がよく知られています。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person879.html",
        "https://ja.wikipedia.org/wiki/%E8%8A%A5%E5%B7%9D%E9%BE%8D%E4%B9%8B%E4%BB%8B",
        "https://ja.wikipedia.org/wiki/%E8%8A%A5%E5%B7%9D%E9%BE%8D%E4%B9%8B%E4%BB%8B%E8%B3%9E"
      ]
    },
    "000148": {
      "name": "夏目漱石",
      "born": "1867-02-09",
      "died": "1916-12-09",
      "episodes": [
        "夏目漱石は1984年から2004年まで、千円札の肖像になっていました。",
        "夏目漱石は文部省の留学生として、イギリスのロンドンに留学しました。",
        "夏目漱石は東京帝国大学の講師を辞め、朝日新聞社に入社して、新聞に小説を書く専属の作家になりました。",
        "「漱石」という号は、負け惜しみの強いことをいう中国の故事「漱石枕流」からとられています。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person148.html",
        "https://ja.wikipedia.org/wiki/%E5%A4%8F%E7%9B%AE%E6%BC%B1%E7%9F%B3"
      ]
    },
    "000035": {
      "name": "太宰治",
      "born": "1909-06-19",
      "died": "1948-06-13",
      "episodes": [
        "太宰治の本名は津島修治です。青森県の大地主の家に生まれました。",
        "太宰治は第1回芥川賞の候補になりましたが受賞できず、選考委員の川端康成に抗議する文章を発表しました。",
        "太宰治の遺体が見つかった6月19日は、太宰の誕生日でした。この日は「桜桃忌」と呼ばれています。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person35.html",
        "https://ja.wikipedia.org/wiki/%E5%A4%AA%E5%AE%B0%E6%B2%BB",
        "https://ja.wikipedia.org/wiki/%E6%A1%9C%E6%A1%83%E5%BF%8C"
      ]
    },
    "000121": {
      "name": "新美南吉",
      "born": "1913-07-30",
      "died": "1943-03-22",
      "episodes": [
        "新美南吉の『ごん狐』は、南吉が18歳のときに雑誌『赤い鳥』に載りました。",
        "新美南吉は小学校の代用教員や女学校の先生をしながら作品を書き、29歳で結核のため亡くなりました。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person121.html",
        "https://ja.wikipedia.org/wiki/%E6%96%B0%E7%BE%8E%E5%8D%97%E5%90%89"
      ]
    },
    "000119": {
      "name": "中島敦",
      "born": "1909-05-05",
      "died": "1942-12-04",
      "episodes": [
        "中島敦は『山月記』で作家として世に出たその年に、33歳で亡くなりました。",
        "中島敦は横浜の女学校で教師をしたあと、南洋庁の役人としてパラオに渡りました。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person119.html",
        "https://ja.wikipedia.org/wiki/%E4%B8%AD%E5%B3%B6%E6%95%A6"
      ]
    },
    "000074": {
      "name": "梶井基次郎",
      "born": "1901-02-17",
      "died": "1932-03-24",
      "episodes": [
        "梶井基次郎は、はじめての作品集『檸檬』が出た翌年に、31歳の若さで亡くなりました。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person74.html"
      ]
    },
    "000129": {
      "name": "森鴎外",
      "born": "1862-02-17",
      "died": "1922-07-09",
      "episodes": [
        "森鴎外の本名は森林太郎です。陸軍の軍医として、最高位の軍医総監まで務めました。",
        "森鴎外はドイツに留学しました。そのころの体験が小説『舞姫』のもとになっています。",
        "森鴎外は遺言で、墓には「鷗外」の号も肩書きも入れず、「森林太郎ノ墓」とだけ刻ませました。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person129.html",
        "https://ja.wikipedia.org/wiki/%E6%A3%AE%E9%B7%97%E5%A4%96"
      ]
    },
    "000025": {
      "name": "有島武郎",
      "born": "1878-03-04",
      "died": "1923-06-09",
      "episodes": [
        "有島武郎は1922年、北海道の狩太村（今のニセコ町）にあった有島農場を開放しました。",
        "有島武郎は、志賀直哉や武者小路実篤らと同じ「白樺派」の作家です。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person25.html",
        "https://ja.wikipedia.org/wiki/%E6%9C%89%E5%B3%B6%E6%AD%A6%E9%83%8E"
      ]
    },
    "000042": {
      "name": "寺田寅彦",
      "born": "1878-11-28",
      "died": "1935-12-31",
      "episodes": [
        "寺田寅彦は物理学者で、東京帝国大学の教授でした。",
        "寺田寅彦は、熊本の第五高等学校で夏目漱石に教わった教え子で、『吾輩は猫である』の寒月君のモデルといわれています。",
        "「天災は忘れた頃にやってくる」は、寺田寅彦の言葉として伝えられています。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person42.html",
        "https://ja.wikipedia.org/wiki/%E5%AF%BA%E7%94%B0%E5%AF%85%E5%BD%A6"
      ]
    },
    "001475": {
      "name": "小川未明",
      "born": "1882-04-07",
      "died": "1961-05-11",
      "episodes": [
        "小川未明は「日本のアンデルセン」と呼ばれました。",
        "小川未明の「未明」という号は、師の坪内逍遙が付けたものです。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person1475.html",
        "https://ja.wikipedia.org/wiki/%E5%B0%8F%E5%B7%9D%E6%9C%AA%E6%98%8E"
      ]
    },
    "000026": {
      "name": "中原中也",
      "born": "1907-04-29",
      "died": "1937-10-22",
      "episodes": [
        "中原中也が生きているあいだに出た詩集は『山羊の歌』だけです。『在りし日の歌』は亡くなったあとに出版されました。",
        "中原中也は30歳で亡くなりました。その前の年には、2歳の長男・文也を亡くしています。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person26.html",
        "https://ja.wikipedia.org/wiki/%E4%B8%AD%E5%8E%9F%E4%B8%AD%E4%B9%9F"
      ]
    },
    "000067": {
      "name": "萩原朔太郎",
      "born": "1886-11-01",
      "died": "1942-05-11",
      "episodes": [
        "萩原朔太郎は口語自由詩を確立した詩人とされ、「日本近代詩の父」と呼ばれています。",
        "萩原朔太郎はマンドリンを習い、故郷の前橋で「ゴンドラ洋楽会」をつくって、演奏会を開きました。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person67.html",
        "https://ja.wikipedia.org/wiki/%E8%90%A9%E5%8E%9F%E6%9C%94%E5%A4%AA%E9%83%8E"
      ]
    },
    "000305": {
      "name": "正岡子規",
      "born": "1867-10-14",
      "died": "1902-09-19",
      "episodes": [
        "「子規」はホトトギスのことです。血を吐くまで鳴くといわれるホトトギスに、結核で血を吐いた自分を重ねました。",
        "正岡子規は野球が大好きでした。「打者」「走者」「四球」「直球」などの訳語を考えて、新聞に書いています。",
        "正岡子規は結核で寝たきりになっても、病床で随筆『病牀六尺』を書きました。"
      ],
      "sources": [
        "https://www.aozora.gr.jp/index_pages/person305.html",
        "https://ja.wikipedia.org/wiki/%E6%AD%A3%E5%B2%A1%E5%AD%90%E8%A6%8F"
      ]
    }
  },
