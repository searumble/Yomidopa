{
  "authors": {
    "000081": {
      "name": "宮沢賢治",
      "born": "1896-08-27",
      "died": "1933-09-21",
      "episodes": [
        "宮沢賢治が生きているあいだに出た本は、詩集『春と修羅』と童話集『注文の多い料理店』の2冊だけでした。",
        "宮沢賢治は花巻の農学校の先生を務め、辞めたあとは「羅須地人協会」を開いて、農民に稲作や芸術を教えました。",
        "〔雨ニモマケズ〕は、宮沢賢治が亡くなったあと、トランクの中にあった手帳から見つかりました。"
      ]
    },
    "000879": {
      "name": "芥川龍之介",
      "born": "1892-03-01",
      "died": "1927-07-24",
      "episodes": [
        "芥川龍之介は、短編『鼻』を夏目漱石に絶賛されたことをきっかけに、文壇に認められました。",
        "芥川賞は、芥川龍之介の友人だった菊池寛が、1935年に芥川の名前をとって創設しました。",
        "芥川龍之介は35歳で自ら命を絶ちました。遺した文章の「ぼんやりした不安」という言葉がよく知られています。"
      ]
    },
    "000148": {
      "name": "夏目漱石",
      "born": "1867-02-09",
      "died": "1916-12-09",
      "episodes": [
        "夏目漱石は1984年から2004年まで、千円札の肖像になっていました。",
        "夏目漱石は国の留学生としてイギリスのロンドンに留学しました。",
        "夏目漱石は東京帝国大学の講師を辞め、朝日新聞社に入社して、新聞に小説を書く専属の作家になりました。",
        "「漱石」という号は、負け惜しみの強いことをいう中国の故事「漱石枕流」からとられています。"
      ]
    },
    "000035": {
      "name": "太宰治",
      "born": "1909-06-19",
      "died": "1948-06-13",
      "episodes": [
        "太宰治の本名は津島修治です。青森県の大地主の家に生まれました。",
        "太宰治は第1回芥川賞の候補になりましたが受賞できず、選考委員の川端康成に抗議する文章を発表しました。",
        "太宰治の遺体が見つかった6月19日は、太宰の誕生日でした。この日は「桜桃忌」と呼ばれています。"
      ]
    },
    "000121": {
      "name": "新美南吉",
      "born": "1913-07-30",
      "died": "1943-03-22",
      "episodes": [
        "新美南吉の『ごん狐』は、南吉が18歳のときに雑誌『赤い鳥』に載りました。",
        "新美南吉は小学校の代用教員や女学校の先生をしながら作品を書き、29歳で結核のため亡くなりました。"
      ]
    },
    "000119": {
      "name": "中島敦",
      "born": "1909-05-05",
      "died": "1942-12-04",
      "episodes": [
        "中島敦は『山月記』で作家として世に出たその年に、33歳で亡くなりました。",
        "中島敦は横浜の女学校で教師をしたあと、南洋庁の役人としてパラオに渡りました。"
      ]
    },
    "000074": {
      "name": "梶井基次郎",
      "born": "1901-02-17",
      "died": "1932-03-24",
      "episodes": [
        "梶井基次郎が生きているあいだに出た作品集は『檸檬』1冊だけでした。31歳で肺結核のため亡くなりました。"
      ]
    },
    "000129": {
      "name": "森鴎外",
      "born": "1862-02-17",
      "died": "1922-07-09",
      "episodes": [
        "森鴎外の本名は森林太郎です。陸軍の軍医として、最高位の軍医総監まで務めました。",
        "森鴎外はドイツに留学しました。そのころの体験が小説『舞姫』のもとになっています。",
        "森鴎外は遺言に「森林太郎トシテ死セント欲ス」と書き、墓には本名だけが刻まれています。"
      ]
    },
    "000025": {
      "name": "有島武郎",
      "born": "1878-03-04",
      "died": "1923-06-09",
      "episodes": [
        "有島武郎は、父から受け継いだ北海道の農場を、そこで働く小作人たちに無償で解放しました。",
        "有島武郎は、志賀直哉や武者小路実篤らと同じ「白樺派」の作家です。"
      ]
    },
    "000042": {
      "name": "寺田寅彦",
      "born": "1878-11-28",
      "died": "1935-12-31",
      "episodes": [
        "寺田寅彦は物理学者で、東京帝国大学の教授でした。",
        "寺田寅彦は、熊本の第五高等学校で夏目漱石に教わった教え子で、『吾輩は猫である』の寒月君のモデルといわれています。",
        "「天災は忘れた頃にやってくる」は、寺田寅彦の言葉として伝えられています。"
      ]
    },
    "001475": {
      "name": "小川未明",
      "born": "1882-04-07",
      "died": "1961-05-11",
      "episodes": [
        "小川未明は「日本のアンデルセン」と呼ばれました。",
        "小川未明は早稲田で坪内逍遙に学び、「未明」という号は逍遙が付けました。"
      ]
    },
    "000026": {
      "name": "中原中也",
      "born": "1907-04-29",
      "died": "1937-10-22",
      "episodes": [
        "中原中也が生きているあいだに出た詩集は『山羊の歌』だけです。『在りし日の歌』は亡くなったあとに出版されました。",
        "中原中也は30歳で亡くなりました。その前の年には、2歳の長男・文也を亡くしています。"
      ]
    },
    "000067": {
      "name": "萩原朔太郎",
      "born": "1886-11-01",
      "died": "1942-05-11",
      "episodes": [
        "萩原朔太郎は詩集『月に吠える』で口語自由詩を確立し、「日本近代詩の父」と呼ばれています。",
        "萩原朔太郎はマンドリンを愛し、故郷の前橋でマンドリンの楽団をつくりました。"
      ]
    },
    "000305": {
      "name": "正岡子規",
      "born": "1867-10-14",
      "died": "1902-09-19",
      "episodes": [
        "「子規」はホトトギスのことです。血を吐くまで鳴くといわれるホトトギスに、結核で血を吐いた自分を重ねました。",
        "正岡子規は野球が大好きでした。「打者」「走者」「直球」などの訳語は子規が作ったといわれています。",
        "正岡子規は結核で寝たきりになっても、亡くなる直前まで随筆『病牀六尺』を新聞に書き続けました。"
      ]
    }
  },
